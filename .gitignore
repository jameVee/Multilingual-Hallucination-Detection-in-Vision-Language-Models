# Excluded per request: paper, thesis proposal, data, images, docs site
/paper/
/thesis proposal/
/data/
/docs/
/shroom-vis-images/

# Trained model weights -- too large for a plain git push (167MB each,
# over GitHub's 100MB hard limit) and not needed to run the code; the
# code that produced them is still tracked.
solutions/*/checkpoint/

# Aim 3 (solution 07) raw feature shards -- per-token hidden-state arrays
# over the full labeled train set are multi-GB uncompressed (n_layers x
# n_heads lookback floats + full hidden-dim vectors per token, x ~500k+
# response tokens), the same "too large to git-push" problem as
# checkpoint/ above but for extracted features instead of trained weights.
# aim3_auc_grid.json (the actual per-cell AUC results) is NOT excluded --
# only the intermediate .npz shards are.
solutions/07_uncertainty_quantification/features/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db
solutions/07_uncertainty_quantification/models*/*.joblib
solutions/07_uncertainty_quantification/features*/
solutions/*/checkpoint*/
.venv/

# thesis_v2 heavy artifacts (checkpoints, predictions, feature shards, API caches)
thesis_v2/runs/

# thesis LaTeX sources and PDF (kept locally, not in the repository)
Skoltech_MSc_Thesis_Template_DS/
